{
  "version": 3,
  "configurePresets": [
    {
      "name": "_base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "_debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "_release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "_clion_msvc_x86",
      "hidden": true,
      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "msvc-x86"
        }
      }
    },
    {
      "name": "_clion_msvc_x64",
      "hidden": true,
      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "msvc-x64"
        }
      }
    },
    {
      "name": "_bl1",
      "hidden": true,
      "cacheVariables": {
        "BLMAKE_ENHANCED": false
      }
    },
    {
      "name": "_bl1e",
      "hidden": true,
      "cacheVariables": {
        "BLMAKE_ENHANCED": true
      }
    },
    {
      "name": "msvc-x86-dbg",
      "inherits": [
        "_base",
        "_clion_msvc_x86",
        "_bl1",
        "_debug"
      ]
    },
    {
      "name": "msvc-x86-rel",
      "inherits": [
        "_base",
        "_clion_msvc_x86",
        "_bl1",
        "_release"
      ]
    },
    {
      "name": "msvc-x64-dbg",
      "inherits": [
        "_base",
        "_clion_msvc_x64",
        "_bl1e",
        "_debug"
      ]
    },
    {
      "name": "msvc-x64-rel",
      "inherits": [
        "_base",
        "_clion_msvc_x64",
        "_bl1e",
        "_release"
      ]
    }
  ]
}
